{
  "name": "toonflow",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck && pnpm --filter functions typecheck",
    "functions:build": "pnpm --filter functions build",
    "emulators": "pnpm functions:build && firebase emulators:start",
    "test:rules": "firebase emulators:exec --only firestore --project demo-toonflow 'vitest run -c vitest.rules.config.ts'"
  },
  "dependencies": {
    "@lucide/vue": "^1.52.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "nuxt": "npm:nuxt-nightly@5x",
    "pinia": "^4.1.0",
    "pretendard": "^1.3.9",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "firebase-tools": "^15.34.0",
    "happy-dom": "20.14.5",
    "shadcn-nuxt": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
