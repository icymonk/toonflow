{
  "hosting": {
    "public": ".output/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/fn/completeOnboarding",
        "function": {
          "functionId": "completeOnboarding",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/fn/setWorkspaceLimit",
        "function": {
          "functionId": "setWorkspaceLimit",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/fn/startAiJob",
        "function": {
          "functionId": "startAiJob",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/fn/cancelAiJob",
        "function": {
          "functionId": "cancelAiJob",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        "src",
        "build.mjs",
        "tsconfig.json",
        "*.log"
      ],
      "predeploy": [
        "pnpm --filter functions build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
